includes:
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    level: max
    paths:
        - .
    excludePaths:
        - vendor
        - node_modules (?)
        - linting
    bootstrapFiles:
        - phpstan-bootstrap.php
    # optional plugins this plugin integrates with (not part of the vendored Matomo)
    scanFiles:
        - phpstan-stubs/LoginPlugins.stub
    stubFiles:
        - phpstan-stubs/Access.stub
    treatPhpDocTypesAsCertain: false
